{% extends "base.xaml" %}

{% block content %}

<local:MyCard Margin="0,0,0,15">
    <Border Padding="12" Background="{DynamicResource ColorBrush4}" CornerRadius="3"
        BorderThickness="3,0,0,0" BorderBrush="{DynamicResource ColorBrush3}">
        <StackPanel Orientation="Horizontal">
            <Path VerticalAlignment="Center" Stretch="Uniform" Height="15" Width="15"
                Margin="0,0,10,0" Fill="White" Data="{DynamicResource LogoGeometry}" />
            <TextBlock Foreground="White" TextWrapping="Wrap" Text="感谢您订阅 Minecraft 芝士站"
                FontWeight="Bold" />
        </StackPanel>
    </Border>
</local:MyCard>

{% for item in page.categories %}
<local:MyCard Title="{{ item.name }}" Margin="0,0,0,15" CanSwap="True">
    <StackPanel Margin="25,40,23,15">
        {%- for source in item.sources %}
        <local:MyListItem
            Logo="pack://application:,,,/images/Blocks/{{ item.logo }}.png"
            Title="{{ source.title }}"
            Info="{{ source.author }}"
            Type="Clickable"
            EventType="弹出窗口"
            EventData="{{ source.title }}|{{ source.content }}" />
        {%- endfor %}
    </StackPanel>
</local:MyCard>
{% endfor %}

<local:MyCard Title="Book and Quill - 芝士新闻" Margin="0,0,0,15" CanSwap="False">
    <StackPanel Margin="25,40,23,15">
        {%- for item in page.announcements %}
        <local:MyListItem
            Logo="pack://application:,,,/images/Blocks/CommandBlock.png"
            Title="{{ item.title }}"
            Info="{{ item.info }}"
            Type="Clickable"
            EventType="{% if item.is_link %}打开网页{% else %}弹出窗口{% endif %}"
            EventData="{% if item.is_link %}{{ item.content }}{% else %}{{ item.title }}|{{ item.content }}{% endif %}" />
        {%- endfor %}
    </StackPanel>
</local:MyCard>

<local:MyCard Margin="0,0,0,15">
    <Border Padding="20,20,20,10" BorderThickness="0,0,0,7"
        BorderBrush="{DynamicResource ColorBrush3}" CornerRadius="5" Margin="-0.6">
        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}" FontSize="20">
                <Bold>PCL2</Bold>
                <Run>Minecraft 芝士站主页（MKSS）</Run>
            </TextBlock>
            <TextBlock Text="By awa_Eric233 - Powered by MKSS.Next Server"
                Foreground="{DynamicResource ColorBrush3}" Margin="0,5,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <local:MyIconTextButton Height="35" ColorType="Highlight" Text="投稿"
                    ToolTip="芝士站需要你的帮助！&#xA;来为本主页贡献你找到的冷知识吧！"
                    EventType="打开网页" EventData="{{ settings['info']['postUrl'] }}"
                    Logo="{{ post_geometry }}" />
                <local:MyIconTextButton Height="35" Text="刷新"
                    ToolTip="重新加载主页，以便更新或调试。" EventType="刷新主页"
                    Logo="{{ refresh_geometry }}" />
                <local:MyIconTextButton Height="35" Text="链接" ToolTip="主页的各类链接。"
                    EventType="打开帮助"
                    EventData="{{ settings['info']['baseUrl'] }}/sub/links.json"
                    Logo="{{ links_geometry }}" />
                <local:MyIconTextButton Height="35" Text="致谢"
                    ToolTip="排名不分先后，感谢所有为主页建设做出贡献的人！"
                    EventType="打开帮助" EventData="{{ settings['info']['baseUrl'] }}/sub/thanks.json"
                    Logo="{{ thanks_geometry }}" />
            </StackPanel>
        </StackPanel>
    </Border>
</local:MyCard>

{% endblock %}